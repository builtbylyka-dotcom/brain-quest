  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Sewn periwinkle tab for the main action on a screen.",
      "html": "<button class=\"ds-btn ds-btn-primary ds-stitched\">Start Playing <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-stitched{position:relative}.ds-stitched::after{content:'';position:absolute;inset:var(--si,6px);border:1.5px dashed var(--sc,var(--stitch));border-radius:calc(var(--sr,1.25rem) - var(--si,6px));pointer-events:none}.ds-btn{display:inline-flex;align-items:center;gap:10px;min-height:56px;padding:0 28px;border-radius:1rem;border:0;font:600 1.05rem 'Nunito Sans Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:transform 220ms cubic-bezier(0.22,1.2,0.36,1),opacity 200ms ease;}.ds-btn-primary{background:var(--primary);color:var(--on-primary);box-shadow:var(--shadow-2);--sc:color-mix(in oklab,var(--on-primary) 45%,transparent);--si:4px;--sr:1rem}.ds-btn-primary:hover{transform:translateY(-2px);box-shadow:var(--shadow-3)}.ds-btn-primary:active{transform:translateY(1px) scale(0.98);transition-duration:90ms;background:var(--primary-press)}.ds-btn:focus-visible{outline:3px solid var(--primary);outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Calico button with a hairline border for the companion action.",
      "html": "<button class=\"ds-btn2\">My Achievements</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;gap:10px;min-height:56px;padding:0 28px;border-radius:1rem;background:var(--surface);color:var(--ink);border:1px solid var(--line);box-shadow:var(--shadow-1);font:600 1.05rem 'Nunito Sans Variable',ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:transform 220ms cubic-bezier(0.22,1.2,0.36,1),opacity 200ms ease;}.ds-btn2:hover{transform:translateY(-2px);border-color:var(--stitch);box-shadow:var(--shadow-2)}.ds-btn2:active{transform:translateY(1px) scale(0.98);background:var(--ground-deep)}.ds-btn2:focus-visible{outline:3px solid var(--primary);outline-offset:3px}"
    },
    {
      "name": "Answer Option",
      "kind": "custom",
      "refersTo": "answer-option",
      "description": "One of four answer tiles; idle, correct and wrong states shown.",
      "html": "<div class=\"ds-ans-grid\"><button class=\"ds-ans\"><span class=\"ds-ans-l\">A</span>Honeycomb</button><button class=\"ds-ans ds-ans-ok\"><span class=\"ds-ans-l\">&#10003;</span>Manna</button><button class=\"ds-ans ds-ans-no\"><span class=\"ds-ans-l\">&#215;</span>Barley loaves</button></div>",
      "css": ".ds-ans-grid{display:grid;gap:12px;max-width:420px}.ds-ans{display:flex;align-items:center;gap:16px;min-height:68px;padding:12px 16px 12px 12px;border-radius:1.1rem;border:2px solid transparent;background:var(--surface);color:var(--ink);box-shadow:var(--shadow-1);font:600 1.05rem 'Nunito Sans Variable',ui-sans-serif,sans-serif;text-align:left;cursor:pointer;transition:transform 220ms cubic-bezier(0.22,1.2,0.36,1),opacity 200ms ease;}.ds-ans:hover{transform:translateY(-2px);border-color:var(--line);box-shadow:var(--shadow-2)}.ds-ans:active{transform:translateY(1px) scale(0.98)}.ds-ans:focus-visible{outline:3px solid var(--primary);outline-offset:2px}.ds-ans-l{display:flex;width:40px;height:40px;flex:none;align-items:center;justify-content:center;border-radius:.75rem;background:var(--fab-muslin);font:700 1.125rem 'Bricolage Grotesque Variable',sans-serif}.ds-ans-ok{border-color:var(--fab-emerald);background:var(--fab-emerald-soft)}.ds-ans-ok .ds-ans-l{background:var(--fab-emerald);color:var(--fab-navy)}.ds-ans-no{border-color:var(--fab-coral);background:var(--fab-coral-soft)}.ds-ans-no .ds-ans-l{background:var(--fab-coral);color:var(--fab-navy)}"
    },
    {
      "name": "Quilt Patch Row",
      "kind": "custom",
      "refersTo": "round-row",
      "description": "A round's row of patches: correct half-square triangles, a missed muslin patch with coral cross-stitch, the current slot, and unsewn seams.",
      "html": "<div class=\"ds-row\"><svg viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"5\" fill=\"var(--fab-gold)\"/><path d=\"M0 0H40L0 40Z\" fill=\"var(--fab-peri)\"/><rect x=\"4\" y=\"4\" width=\"32\" height=\"32\" rx=\"2.5\" fill=\"none\" stroke=\"var(--ink)\" stroke-opacity=\".28\" stroke-dasharray=\"2.5 2.5\"/></svg><svg viewBox=\"0 0 40 40\"><rect width=\"40\" height=\"40\" rx=\"5\" fill=\"var(--fab-muslin)\"/><path d=\"M17.5 17.5l5 5M22.5 17.5l-5 5\" stroke=\"var(--fab-coral)\" stroke-width=\"2\" stroke-linecap=\"round\"/><rect x=\"4\" y=\"4\" width=\"32\" height=\"32\" rx=\"2.5\" fill=\"none\" stroke=\"var(--ink)\" stroke-opacity=\".28\" stroke-dasharray=\"2.5 2.5\"/></svg><svg viewBox=\"0 0 40 40\"><rect x=\"1\" y=\"1\" width=\"38\" height=\"38\" rx=\"5\" fill=\"var(--surface)\" stroke=\"var(--stitch)\" stroke-width=\"1.5\" stroke-dasharray=\"3.5 3\"/></svg><svg viewBox=\"0 0 40 40\"><rect x=\"1\" y=\"1\" width=\"38\" height=\"38\" rx=\"5\" fill=\"var(--surface)\" stroke=\"var(--stitch)\" stroke-width=\"1.5\" stroke-dasharray=\"3.5 3\"/></svg></div>",
      "css": ".ds-row{display:grid;grid-template-columns:repeat(4,48px);gap:6px}.ds-row svg{display:block;width:48px;height:48px}"
    },
    {
      "name": "Sewn Label Card",
      "kind": "card",
      "refersTo": "quilt-label",
      "description": "The surface for headings, dialogs and the home welcome: calico with an inset running stitch.",
      "html": "<div class=\"ds-label ds-stitched\"><h3 class=\"ds-label-t\">Leave this round?</h3><p class=\"ds-label-p\">Your progress in this round won't be saved.</p></div>",
      "css": ".ds-stitched{position:relative}.ds-stitched::after{content:'';position:absolute;inset:var(--si,6px);border:1.5px dashed var(--sc,var(--stitch));border-radius:calc(var(--sr,1.25rem) - var(--si,6px));pointer-events:none}.ds-label{max-width:380px;padding:32px;border-radius:1.5rem;background:var(--surface);color:var(--ink);box-shadow:var(--shadow-3);--si:8px;--sr:1.5rem}.ds-label-t{margin:0;font:700 1.5rem/1.2 'Bricolage Grotesque Variable',sans-serif;letter-spacing:-0.02em}.ds-label-p{margin:8px 0 0;color:var(--ink-soft);font:400 1rem/1.7 'Nunito Sans Variable',sans-serif}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Header nav; the current page wears its own soft fabric.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-i ds-nav-gold\">Achievements</button><button class=\"ds-nav-i\">Stats</button></nav>",
      "css": ".ds-nav{display:flex;gap:4px}.ds-nav-i{min-height:44px;padding:0 14px;border:0;border-radius:.75rem;background:transparent;color:var(--ink-soft);font:600 .875rem 'Nunito Sans Variable',sans-serif;cursor:pointer;transition:transform 220ms cubic-bezier(0.22,1.2,0.36,1),opacity 200ms ease;}.ds-nav-i:hover{background:var(--ground-deep);color:var(--ink);transform:translateY(-2px)}.ds-nav-i:active{background:var(--line);transform:translateY(1px) scale(.98)}.ds-nav-i:focus-visible{outline:3px solid var(--primary);outline-offset:3px}.ds-nav-gold{background:var(--fab-gold-soft);color:var(--ink)}"
    },
    {
      "name": "Reference Chip",
      "kind": "chip",
      "refersTo": "reference-chip",
      "description": "Scripture reference pill under each explanation.",
      "html": "<span class=\"ds-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--accent-text)\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"/></svg>Exodus 16:31</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:9999px;background:var(--surface-raised);color:var(--ink);box-shadow:var(--shadow-1);font:700 .875rem 'Nunito Sans Variable',sans-serif}"
    }
  ],
  "narrative": {
    "northStar": "The Answer Quilt",
    "overview": "**Creative North Star: \"The Answer Quilt\"**\n\nBrain Quest is a modern patchwork quilt you sew one answer at a time. Every question is a patch, a round is a row of ten, and a player's history is a quilt that grows across the home screen. The ground is unbleached muslin, the ink is navy thread, and colour arrives as flat fabric laid with full commitment: periwinkle, sage, gold, coral and emerald, pieced into half-square triangles and edged with dashed running stitches.\n\nThe system is cozy but not childish. Large Bricolage Grotesque headings sit on calm Nunito Sans body copy with generous 1.7 leading; surfaces are sewn-on labels with a running stitch just inside the edge; depth is soft and navy-tinted rather than grey. Modern-quilt negative space matters as much as the fabric: plain muslin patches and quiet ground are the canvas the coloured patches read against. Statistics and progress are drawn as quilt geometry (patch rows, strip-pieced bars), never stock charts.\n\nThe first visit shows a sample cloth of diagonal fabric stripes. Once the player has any history, the quilt shows only their real rows plus plain muslin; the sample is unpicked.",
    "keyCharacteristics": [
      "Muslin ground, navy ink, flat fabric fields; no gradients on fabric.",
      "Half-square-triangle patches with dashed running-stitch seams.",
      "Sewn-label surfaces: a dashed stitch inset 4 to 8px from the edge of primary buttons, dialogs, question cards and the home label.",
      "Strict colour law: emerald means correct, coral means incorrect, gold means achievements and hints.",
      "Soft, layered, navy-tinted elevation; motion is transform and opacity only, with a springy settle."
    ],
    "rules": [
      {
        "name": "The Colour Law Rule",
        "body": "Emerald means correct, coral means incorrect, gold means achievements and hints. No signal colour is borrowed for decoration, status, or emphasis elsewhere in the interface.",
        "section": "colors"
      },
      {
        "name": "The Cloth Exception Rule",
        "body": "Inside the quilt itself (patches, category and pattern swatches, the brand mark), every fabric is cloth, not signal, and may be pieced freely. A correct patch is a half-square triangle in the round's two fabrics; a missed answer is a muslin patch with a small coral cross-stitch; a timed-out answer is muslin with a small dashed coral ring.",
        "section": "colors"
      },
      {
        "name": "The Text-Tone Rule",
        "body": "Fabric fills are too light for text. Any coloured text uses the matching `-text` token (sage-text, gold-text, coral-text, emerald-text, accent-text).",
        "section": "colors"
      },
      {
        "name": "The Two-Thread Rule",
        "body": "Bricolage is for headings and numbers; Nunito Sans is for everything you read. Body copy never sets in the display face.",
        "section": "typography"
      },
      {
        "name": "The 1.7 Rule",
        "body": "Body and lede copy run at line-height 1.7. Headings run tight (1.05) with -0.03em tracking and balanced wrapping.",
        "section": "typography"
      },
      {
        "name": "The Sewn-Piece Rule",
        "body": "Elevation rises one step on hover and settles on press. Nothing floats without a reason: the scrim (navy at 45%) is the only full-screen layer.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** draw progress and statistics as quilt geometry: patch rows and strip-pieced bars.",
      "**Do** keep fabric fills flat and let plain muslin carry the negative space.",
      "**Do** put a running stitch inside every sewn piece that matters (primary buttons, labels, dialogs, toasts), inset 4 to 8px.",
      "**Do** use the `-text` tokens for any coloured text, and tabular figures for every number.",
      "**Do** give every clickable element hover, focus-visible and active states, with a 44px minimum target.",
      "**Do** honour reduced motion from both the OS setting and the in-app setting."
    ],
    "donts": [
      "**Don't** use emerald, coral or gold as interface signals for anything but correct, incorrect, and achievements-and-hints respectively; inside the quilt they are cloth.",
      "**Don't** show the sample stripes once a player has history; real rows plus plain muslin only.",
      "**Don't** use stock charts, confetti, or a plain progress bar for round progress.",
      "**Don't** animate colour, size or layout properties; animate transform and opacity only.",
      "**Don't** use uppercase or letter-spaced labels; labels are sentence case.",
      "**Don't** use grey or hard offset shadows; elevation is soft and navy-tinted."
    ]
  }
}
